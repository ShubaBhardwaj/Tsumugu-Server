# Safe placeholders only. Supply your own development credentials.
NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:8080
# Google web OAuth redirect: <BETTER_AUTH_URL>/api/auth/callback/google
# Native return scheme: tsumugu:// (configured in code, separate from CLIENT_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/tsumugu
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=tsumugu
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIRECRAWL_API_KEY=
# Optional
TAVILY_API_KEY=
MEM0_API_KEY=
# Local worker mode only. Disable in production and configure both keys.
INNGEST_DEV=true
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
